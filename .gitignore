# ==============================
# FIR SE - Global Git Ignore
# ==============================

# Environment variables & secrets
.env
.env.*
!.env.example

# ==============================
# Node / Frontend
# ==============================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
build/
.next/
out/
.cache/

# ==============================
# Python / Backend / AI
# ==============================

__pycache__/
*.py[cod]
*$py.class

*.so

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/
.eggs/

# ==============================
# Jupyter
# ==============================

.ipynb_checkpoints/

# ==============================
# Machine Learning
# ==============================

*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.pkl
*.joblib

# ==============================
# Data
# ==============================

# Ignore raw/local datasets
data/raw/

# Ignore generated datasets
data/processed/

# ==============================
# Logs
# ==============================

*.log
logs/

# ==============================
# OS files
# ==============================

.DS_Store
Thumbs.db
desktop.ini

# ==============================
# IDE / Editors
# ==============================

.vscode/
.idea/
*.swp
*.swo

# ==============================
# Coverage
# ==============================

.coverage
htmlcov/
coverage.xml

# ==============================
# Temporary files
# ==============================

tmp/
temp/
*.tmp
*.temp# ==============================
